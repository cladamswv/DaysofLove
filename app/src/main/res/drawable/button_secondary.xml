<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#F8DCE7" />
            <stroke android:width="1dp" android:color="#C92861" />
            <corners android:radius="18dp" />
            <padding android:left="16dp" android:right="16dp" android:top="12dp" android:bottom="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFF7FA" />
            <stroke android:width="1dp" android:color="#D84475" />
            <corners android:radius="18dp" />
            <padding android:left="16dp" android:right="16dp" android:top="12dp" android:bottom="12dp" />
        </shape>
    </item>
</selector>
