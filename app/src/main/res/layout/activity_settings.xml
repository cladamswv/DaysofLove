<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@drawable/screen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="18dp"
        android:paddingRight="18dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="22dp"
            android:background="@drawable/hero_gradient"
            android:elevation="5dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Make it yours 💗"
                android:textColor="#FFFFFF"
                android:textSize="29sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="Colors, reminders and the little details that make it feel personal."
                android:textColor="#FFF2F7"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/card_background"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Widget style"
                android:textColor="#6F1739"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Start with a romantic theme, or fine-tune the colors yourself."
                android:textColor="#7F6771"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/theme_spinner"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/input_background" />

            <TextView
                android:id="@+id/settings_widget_preview"
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:padding="14dp"
                android:text="454 days of love ❤️"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Background color"
                android:textColor="#6F1739"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/background_hex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/input_background"
                android:hint="#D4145A"
                android:inputType="text"
                android:maxLength="7"
                android:singleLine="true"
                android:textColor="#4C2737"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Text color"
                android:textColor="#6F1739"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/text_hex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/input_background"
                android:hint="#FFFFFF"
                android:inputType="text"
                android:maxLength="7"
                android:singleLine="true"
                android:textColor="#4C2737"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/transparency_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Background strength: 100%"
                android:textColor="#6F1739"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/transparency_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="100" />

            <Button
                android:id="@+id/preview_custom_colors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_secondary"
                android:backgroundTint="@null"
                android:minHeight="50dp"
                android:text="Preview custom colors"
                android:textAllCaps="false"
                android:textColor="#A51D50"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/card_background"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notifications"
                android:textColor="#6F1739"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Every notification type has its own switch. Nothing needs to nag you."
                android:textColor="#7F6771"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/master_notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Master notifications"
                android:textColor="#4C2737"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/persistent_counter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Daily love counter notification"
                android:textColor="#4C2737"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/anniversary_notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Anniversary reminders"
                android:textColor="#4C2737"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/monthsary_notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Monthsary reminders"
                android:textColor="#4C2737"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/milestone_notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Day milestone celebrations"
                android:textColor="#4C2737"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/gift_notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Gift-plan reminders"
                android:textColor="#4C2737"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Anniversary heads-up"
                android:textColor="#6F1739"
                android:textSize="15sp"
                android:textStyle="bold" />

            <CheckBox android:id="@+id/anniv_30" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="30 days before" android:textColor="#5B3B48" />
            <CheckBox android:id="@+id/anniv_14" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="14 days before" android:textColor="#5B3B48" />
            <CheckBox android:id="@+id/anniv_7" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="7 days before" android:textColor="#5B3B48" />
            <CheckBox android:id="@+id/anniv_final_week" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Every day during the final week" android:textColor="#5B3B48" />
            <CheckBox android:id="@+id/anniv_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="3 days before" android:textColor="#5B3B48" />
            <CheckBox android:id="@+id/anniv_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1 day before" android:textColor="#5B3B48" />
            <CheckBox android:id="@+id/anniv_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="On the anniversary" android:textColor="#5B3B48" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Monthsary heads-up"
                android:textColor="#6F1739"
                android:textSize="15sp"
                android:textStyle="bold" />

            <CheckBox android:id="@+id/monthsary_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1 day before" android:textColor="#5B3B48" />
            <CheckBox android:id="@+id/monthsary_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="On the monthsary" android:textColor="#5B3B48" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Reminder time"
                android:textColor="#6F1739"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/reminder_time"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/input_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Gift-plan reminders currently open Days of Love. A shopping/gift hub can be added later without changing the reminder system."
                android:textColor="#937681"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/save_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/button_primary"
            android:backgroundTint="@null"
            android:minHeight="56dp"
            android:text="Save my settings ❤️"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/reset_appearance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_secondary"
            android:backgroundTint="@null"
            android:minHeight="52dp"
            android:text="Reset appearance"
            android:textAllCaps="false"
            android:textColor="#A51D50"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Your relationship details are stored locally on this device."
            android:textColor="#9B7A87"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
